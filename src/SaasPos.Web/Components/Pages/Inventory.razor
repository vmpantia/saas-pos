@page "/inventory"
@inject ApiClient Api
@inject ToastService Toast

<div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Inventory</h1>
    <p class="text-sm text-muted-foreground">Track stock levels and movements</p>
</div>
@if (_error is not null) { <div class="alert alert-destructive mb-4">@_error</div> }

<div class="@($"grid gap-6 {(_sel is null ? "" : "lg:grid-cols-2")}")">
    <div class="card">
        <div class="flex flex-wrap items-center gap-3 p-4">
            <div class="relative w-full max-w-xs">
                <span class="pointer-events-none absolute left-3 top-2.5 text-muted-foreground"><Icon Name="search" /></span>
                <input class="input pl-9" placeholder="Search..." @bind="_search" @bind:event="oninput" />
            </div>
            <div class="flex-1"></div>
            <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="size-4 accent-primary" @bind="_lowOnly" />Low stock only</label>
        </div>
        <div class="overflow-x-auto">
            <table class="table">
                <thead><tr><th>Product</th><th class="min-w-40">Stock level</th><th>On hand</th></tr></thead>
                <tbody>
                    @foreach (var p in Visible)
                    {
                        <tr class="@(_sel?.Id == p.Id ? "bg-muted/50" : "") cursor-pointer" @onclick="() => Select(p)">
                            <td><div class="font-medium">@p.Name</div><div class="text-xs text-muted-foreground">@p.Sku</div></td>
                            <td><div class="@($"progress {Tone(p, "progress")}")"><div style="width:@Pct(p)%"></div></div></td>
                            <td><span class="@($"badge {Tone(p, "badge")}")">@p.QuantityOnHand / @p.ReorderLevel</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Visible.Any()) { <div class="p-10 text-center text-sm text-muted-foreground">No products found.</div> }
        </div>
    </div>

    @if (_sel is not null)
    {
        <div class="card self-start">
            <div class="card-header flex-row items-start justify-between">
                <div>
                    <h2 class="card-title">@_sel.Name</h2>
                    <p class="card-desc mt-1">@_sel.Sku · @_sel.QuantityOnHand on hand</p>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick="() => _sel = null"><Icon Name="x" /></button>
            </div>
            <div class="card-body flex flex-col gap-6">
                <div>
                    <h3 class="mb-2 text-sm font-medium">Receive stock</h3>
                    <div class="flex gap-2">
                        <input type="number" min="0" class="input w-28" placeholder="Qty" @bind="_receiveQty" />
                        <input class="input" placeholder="Reference (PO #)" @bind="_ref" />
                        <button class="btn btn-default" @onclick="Receive">Receive</button>
                    </div>
                </div>
                <div>
                    <h3 class="mb-2 text-sm font-medium">Stock count</h3>
                    <div class="flex gap-2">
                        <input type="number" min="0" class="input w-28" placeholder="Counted" @bind="_count" />
                        <input class="input" placeholder="Reason" @bind="_note" />
                        <button class="btn btn-outline" @onclick="Adjust">Set count</button>
                    </div>
                </div>
                <div>
                    <h3 class="mb-2 text-sm font-medium">Movement history</h3>
                    <div class="overflow-x-auto rounded-md border">
                        <table class="table">
                            <thead><tr><th>When</th><th>Type</th><th>Change</th><th>Balance</th></tr></thead>
                            <tbody>
                                @foreach (var m in _moves.Take(20))
                                {
                                    <tr>
                                        <td class="text-muted-foreground">@m.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                        <td><span class="badge badge-secondary">@m.Type</span></td>
                                        <td class="@(m.QuantityChange < 0 ? "text-destructive" : "text-success") font-semibold">@(m.QuantityChange > 0 ? "+" : "")@m.QuantityChange</td>
                                        <td>@m.BalanceAfter</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_moves.Count == 0) { <div class="p-6 text-center text-sm text-muted-foreground">No movements yet.</div> }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> _items = [];
    private List<StockMovementDto> _moves = [];
    private ProductDto? _sel;
    private int _receiveQty, _count;
    private bool _lowOnly;
    private string? _ref, _note, _error;
    private string _search = "";

    private IEnumerable<ProductDto> Visible => _items.Where(p =>
        (!_lowOnly || p.IsLowStock) &&
        (string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private static string Pct(ProductDto p)
    {
        var target = Math.Max(1, p.ReorderLevel * 3);
        return Math.Min(100, p.QuantityOnHand * 100.0 / target).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string Tone(ProductDto p, string prefix) =>
        p.QuantityOnHand == 0 ? $"{prefix}-destructive" : p.IsLowStock ? $"{prefix}-warning" : $"{prefix}-success";

    protected override Task OnInitializedAsync() => Load();

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private Task Load() => Run(async () => _items = await Api.ProductsAsync());

    private Task Select(ProductDto p) => Run(async () =>
    {
        _sel = p; _count = p.QuantityOnHand;
        _moves = await Api.MovementsAsync(p.Id);
    });

    private Task Receive() => Run(async () =>
    {
        _sel = await Api.ReceiveAsync(_sel!.Id, new ReceiveStockRequest(_receiveQty, _ref, null));
        _receiveQty = 0; _ref = null; _count = _sel.QuantityOnHand;
        Toast.Show("Stock received");
        await Refresh();
    });

    private Task Adjust() => Run(async () =>
    {
        _sel = await Api.AdjustAsync(_sel!.Id, new AdjustStockRequest(_count, _note));
        _note = null;
        Toast.Show("Stock count updated");
        await Refresh();
    });

    private async Task Refresh()
    {
        _moves = await Api.MovementsAsync(_sel!.Id);
        _items = await Api.ProductsAsync();
    }
}
