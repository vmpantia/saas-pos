@page "/inventory"
@inject ApiClient Api

<h3>Inventory</h3>
@if (_error is not null) { <div class="alert alert-danger">@_error</div> }

<table class="table table-sm align-middle">
    <thead><tr><th>SKU</th><th>Product</th><th class="text-end">On hand</th><th class="text-end">Reorder at</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in _items)
    {
        <tr class="@(p.IsLowStock ? "table-warning" : "")">
            <td>@p.Sku</td><td>@p.Name</td><td class="text-end">@p.QuantityOnHand</td><td class="text-end">@p.ReorderLevel</td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary" @onclick="() => Select(p)">Manage</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (_sel is not null)
{
    <div class="card card-body">
        <h5>@_sel.Name — @_sel.QuantityOnHand on hand</h5>
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="number" min="1" class="form-control" placeholder="Receive qty" @bind="_receiveQty" /></div>
            <div class="col-auto"><input class="form-control" placeholder="Reference (PO #)" @bind="_ref" /></div>
            <div class="col-auto"><button class="btn btn-success" @onclick="Receive">Receive stock</button></div>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="number" min="0" class="form-control" placeholder="Counted qty" @bind="_count" /></div>
            <div class="col-auto"><input class="form-control" placeholder="Reason" @bind="_note" /></div>
            <div class="col-auto"><button class="btn btn-warning" @onclick="Adjust">Set count</button></div>
        </div>
        <table class="table table-sm">
            <thead><tr><th>When</th><th>Type</th><th class="text-end">Change</th><th class="text-end">Balance</th><th>Ref / note</th></tr></thead>
            <tbody>
            @foreach (var m in _moves)
            {
                <tr><td>@m.CreatedAtUtc.ToLocalTime().ToString("g")</td><td>@m.Type</td><td class="text-end">@m.QuantityChange</td><td class="text-end">@m.BalanceAfter</td><td>@m.Reference @m.Note</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductDto> _items = [];
    private List<StockMovementDto> _moves = [];
    private ProductDto? _sel;
    private int _receiveQty, _count;
    private string? _ref, _note, _error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private Task Load() => Run(async () => _items = await Api.ProductsAsync());

    private Task Select(ProductDto p) => Run(async () =>
    {
        _sel = p; _count = p.QuantityOnHand;
        _moves = await Api.MovementsAsync(p.Id);
    });

    private Task Receive() => Run(async () =>
    {
        _sel = await Api.ReceiveAsync(_sel!.Id, new ReceiveStockRequest(_receiveQty, _ref, null));
        _receiveQty = 0; _ref = null;
        await Refresh();
    });

    private Task Adjust() => Run(async () =>
    {
        _sel = await Api.AdjustAsync(_sel!.Id, new AdjustStockRequest(_count, _note));
        _note = null;
        await Refresh();
    });

    private async Task Refresh()
    {
        _moves = await Api.MovementsAsync(_sel!.Id);
        _items = await Api.ProductsAsync();
    }
}
