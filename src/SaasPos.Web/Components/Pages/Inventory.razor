@page "/inventory"
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="page-title">Inventory</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Track stock levels and movements</MudText>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert> }

<MudGrid>
    <MudItem xs="12" lg="@(_sel is null ? 12 : 6)">
        <MudTable Items="_items" Hover="true" Elevation="0" Filter="Match" Breakpoint="Breakpoint.Sm" OnRowClick="@((TableRowClickEventArgs<ProductDto> a) => Select(a.Item!))">
            <ToolBarContent>
                <MudTextField @bind-Value="_search" Placeholder="Search…" Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Style="max-width:280px" />
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_lowOnly" Label="Low stock only" Color="Color.Warning" />
            </ToolBarContent>
            <HeaderContent><MudTh>Product</MudTh><MudTh Style="min-width:180px">Stock level</MudTh><MudTh>On hand</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@context.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Sku</MudText>
                </MudTd>
                <MudTd><MudProgressLinear Value="@Level(context)" Max="100" Rounded="true" Color="@(context.QuantityOnHand == 0 ? Color.Error : context.IsLowStock ? Color.Warning : Color.Success)" /></MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.QuantityOnHand == 0 ? Color.Error : context.IsLowStock ? Color.Warning : Color.Success)">
                        @context.QuantityOnHand / reorder @context.ReorderLevel
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    </MudItem>

    @if (_sel is not null)
    {
        <MudItem xs="12" lg="6">
            <div class="soft-card pa-5">
                <div class="d-flex align-center mb-1">
                    <div>
                        <MudText Typo="Typo.h6">@_sel.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_sel.Sku · @_sel.QuantityOnHand on hand</MudText>
                    </div>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _sel = null" />
                </div>
                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Receive stock</MudText>
                <div class="d-flex gap-2 mb-4">
                    <MudNumericField T="int" @bind-Value="_receiveQty" Min="0" Label="Quantity" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Style="max-width:130px" />
                    <MudTextField @bind-Value="_ref" Label="Reference (PO #)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Receive">Receive</MudButton>
                </div>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Stock count</MudText>
                <div class="d-flex gap-2 mb-4">
                    <MudNumericField T="int" @bind-Value="_count" Min="0" Label="Counted" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Style="max-width:130px" />
                    <MudTextField @bind-Value="_note" Label="Reason" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Adjust">Set count</MudButton>
                </div>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Movement history</MudText>
                <MudTable Items="_moves" Dense="true" Elevation="0">
                    <HeaderContent><MudTh>When</MudTh><MudTh>Type</MudTh><MudTh>Change</MudTh><MudTh>Balance</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TypeColor(context.Type)">@context.Type</MudChip></MudTd>
                        <MudTd Style="@($"font-weight:600;color:var(--mud-palette-{(context.QuantityChange < 0 ? "error" : "success")})")">@(context.QuantityChange > 0 ? "+" : "")@context.QuantityChange</MudTd>
                        <MudTd>@context.BalanceAfter</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            </div>
        </MudItem>
    }
</MudGrid>

@code {
    private List<ProductDto> _items = [];
    private List<StockMovementDto> _moves = [];
    private ProductDto? _sel;
    private int _receiveQty, _count;
    private bool _lowOnly;
    private string? _ref, _note, _error;
    private string _search = "";

    private bool Match(ProductDto p) =>
        (!_lowOnly || p.IsLowStock) &&
        (string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static double Level(ProductDto p)
    {
        var target = Math.Max(1, p.ReorderLevel * 3);
        return Math.Min(100, p.QuantityOnHand * 100.0 / target);
    }

    private static Color TypeColor(StockMovementType t) => t switch
    {
        StockMovementType.Purchase => Color.Success,
        StockMovementType.Sale => Color.Info,
        StockMovementType.Return => Color.Secondary,
        _ => Color.Warning
    };

    protected override Task OnInitializedAsync() => Load();

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private Task Load() => Run(async () => _items = await Api.ProductsAsync());

    private Task Select(ProductDto p) => Run(async () =>
    {
        _sel = p; _count = p.QuantityOnHand;
        _moves = await Api.MovementsAsync(p.Id);
    });

    private Task Receive() => Run(async () =>
    {
        _sel = await Api.ReceiveAsync(_sel!.Id, new ReceiveStockRequest(_receiveQty, _ref, null));
        _receiveQty = 0; _ref = null; _count = _sel.QuantityOnHand;
        Snackbar.Add("Stock received", Severity.Success);
        await Refresh();
    });

    private Task Adjust() => Run(async () =>
    {
        _sel = await Api.AdjustAsync(_sel!.Id, new AdjustStockRequest(_count, _note));
        _note = null;
        Snackbar.Add("Stock count updated", Severity.Success);
        await Refresh();
    });

    private async Task Refresh()
    {
        _moves = await Api.MovementsAsync(_sel!.Id);
        _items = await Api.ProductsAsync();
    }
}
