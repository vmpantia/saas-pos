@page "/login"
@inject ApiClient Api
@inject Session Session

<div class="card w-full max-w-sm shadow-lg">
    <div class="card-header items-center pb-2 text-center">
        <div class="mb-2 flex size-12 items-center justify-center rounded-xl bg-primary text-primary-foreground"><Icon Name="cart" Class="size-6" /></div>
        <h1 class="card-title text-xl">Welcome back</h1>
        <p class="card-desc">Sign in to your store to continue</p>
    </div>
    <div class="card-body flex flex-col gap-4">
        <div>
            <label class="label" for="tenant">Store code</label>
            <input id="tenant" class="input" @bind="_tenant" @bind:event="oninput" placeholder="demo" />
        </div>
        <div>
            <label class="label" for="user">Username</label>
            <input id="user" class="input" @bind="_user" @bind:event="oninput" />
        </div>
        <div>
            <label class="label" for="pass">Password</label>
            <input id="pass" type="password" class="input" @bind="_pass" @bind:event="oninput" @onkeydown="OnKey" />
        </div>
        @if (_error is not null) { <div class="alert alert-destructive"><Icon Name="alert" Class="mt-0.5 size-4 shrink-0" />@_error</div> }
        <button class="btn btn-default btn-lg w-full" disabled="@_busy" @onclick="Submit">@(_busy ? "Signing in..." : "Sign in")</button>
    </div>
</div>

@code {
    private string _tenant = "", _user = "", _pass = "";
    private string? _error;
    private bool _busy;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Submit(); }

    private async Task Submit()
    {
        _busy = true; _error = null;
        try { await Session.SignInAsync(await Api.LoginAsync(new(_tenant, _user, _pass))); }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = "Cannot reach the server."; }
        finally { _busy = false; }
    }
}
