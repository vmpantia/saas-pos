@page "/login"
@inject ApiClient Api
@inject Session Session

<MudPaper Class="pa-6">
    <MudText Typo="Typo.h5" Class="mb-4">SaaS POS — Sign in</MudText>
    <MudTextField @bind-Value="_tenant" Label="Store code" Variant="Variant.Outlined" Class="mb-2" />
    <MudTextField @bind-Value="_user" Label="Username" Variant="Variant.Outlined" Class="mb-2" />
    <MudTextField @bind-Value="_pass" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3"
                  OnKeyDown="OnKey" />
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="Submit">Sign in</MudButton>
</MudPaper>

@code {
    private string _tenant = "", _user = "", _pass = "";
    private string? _error;
    private bool _busy;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Submit(); }

    private async Task Submit()
    {
        _busy = true; _error = null;
        try { await Session.SignInAsync(await Api.LoginAsync(new(_tenant, _user, _pass))); }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = "Cannot reach the server."; }
        finally { _busy = false; }
    }
}
