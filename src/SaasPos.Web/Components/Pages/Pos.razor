@page "/pos"
@inject ApiClient Api
@inject ToastService Toast

<div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Point of Sale</h1>
    <p class="text-sm text-muted-foreground">Tap a product or scan a barcode to start an order</p>
</div>
@if (_error is not null) { <div class="alert alert-destructive mb-4">@_error</div> }

<div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <div class="relative mb-4">
            <span class="pointer-events-none absolute left-3 top-2.5 text-muted-foreground"><Icon Name="search" /></span>
            <input class="input pl-9" placeholder="Search name or SKU. Press Enter to scan a barcode" @bind="_term" @bind:event="oninput" @onkeydown="OnKey" />
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
            @foreach (var p in Filtered)
            {
                var out_ = p.QuantityOnHand <= 0;
                <button type="button" disabled="@out_" @onclick="() => Add(p)"
                        class="card flex flex-col items-start gap-1 p-4 text-left transition hover:border-primary/40 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50">
                    <span class="@($"badge {(out_ ? "badge-destructive" : p.IsLowStock ? "badge-warning" : "badge-secondary")}")">@(out_ ? "Out of stock" : $"{p.QuantityOnHand} in stock")</span>
                    <span class="mt-2 line-clamp-2 text-sm font-medium leading-tight">@p.Name</span>
                    <span class="text-xs text-muted-foreground">@p.Sku</span>
                    <span class="mt-1 text-lg font-semibold">@p.Price.ToString("N2")</span>
                </button>
            }
        </div>
        @if (!Filtered.Any())
        {
            <div class="card flex flex-col items-center gap-2 p-10 text-muted-foreground"><Icon Name="inbox" Class="size-8" />No products found.</div>
        }
    </div>

    <div>
        <div class="card sticky top-20">
            <div class="card-header flex-row items-center justify-between">
                <h2 class="card-title">Current order</h2>
                @if (_cart.Count > 0) { <button class="btn btn-ghost btn-sm text-destructive" @onclick="() => _cart.Clear()">Clear</button> }
            </div>
            <div class="card-body flex flex-col gap-4">
                @if (_cart.Count == 0)
                {
                    <div class="flex flex-col items-center gap-2 py-6 text-sm text-muted-foreground"><Icon Name="cart" Class="size-8" />Cart is empty</div>
                }
                <div class="flex flex-col">
                    @foreach (var l in _cart)
                    {
                        <div class="flex items-center gap-2 border-b py-3 last:border-0">
                            <div class="min-w-0 flex-1">
                                <div class="truncate text-sm font-medium">@l.Product.Name</div>
                                <div class="text-xs text-muted-foreground">@l.Product.Price.ToString("N2") each</div>
                            </div>
                            <button class="btn btn-outline btn-icon btn-sm" @onclick="() => Change(l, -1)"><Icon Name="minus" /></button>
                            <span class="w-6 text-center text-sm font-medium">@l.Quantity</span>
                            <button class="btn btn-outline btn-icon btn-sm" @onclick="() => Change(l, 1)"><Icon Name="plus" /></button>
                            <span class="w-16 text-right text-sm font-semibold">@((l.Product.Price * l.Quantity).ToString("N2"))</span>
                        </div>
                    }
                </div>

                <div>
                    <label class="label">Discount</label>
                    <input type="number" min="0" step="0.01" class="input" @bind="_discount" @bind:event="oninput" />
                </div>
                <div class="flex items-center justify-between border-t pt-4">
                    <span class="text-muted-foreground">Total</span>
                    <span class="text-2xl font-bold tracking-tight">@Total.ToString("N2")</span>
                </div>

                <div class="segmented">
                    @foreach (var m in Enum.GetValues<PaymentMethod>())
                    {
                        var mm = m;
                        <button type="button" class="@(_method == mm ? "on" : "")" @onclick="() => _method = mm">@mm</button>
                    }
                </div>
                <div>
                    <label class="label">Amount tendered</label>
                    <input type="number" min="0" step="0.01" class="input" @bind="_tendered" @bind:event="oninput" />
                    @if (_tendered > 0 && _tendered >= Total)
                    {
                        <p class="mt-2 text-sm text-success">Change due: <strong>@((_tendered - Total).ToString("N2"))</strong></p>
                    }
                </div>
                <button class="btn btn-default btn-lg w-full" disabled="@(_cart.Count == 0 || _busy)" @onclick="Checkout">Charge @Total.ToString("N2")</button>
            </div>
        </div>
    </div>
</div>

@code {
    private class Line { public ProductDto Product { get; set; } = default!; public int Quantity { get; set; } = 1; }

    private List<ProductDto> _products = [];
    private readonly List<Line> _cart = [];
    private string _term = "";
    private decimal _discount, _tendered;
    private PaymentMethod _method = PaymentMethod.Cash;
    private string? _error;
    private bool _busy;

    private IEnumerable<ProductDto> Filtered => _products.Where(p =>
        string.IsNullOrWhiteSpace(_term) || p.Name.Contains(_term, StringComparison.OrdinalIgnoreCase)
        || p.Sku.Contains(_term, StringComparison.OrdinalIgnoreCase) || p.Barcode == _term.Trim());

    private decimal Total => Math.Max(0, _cart.Sum(l => l.Product.Price * l.Quantity) - _discount);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _products = await Api.ProductsAsync(null, true); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var t = _term.Trim();
        var hit = _products.FirstOrDefault(p => p.Barcode == t || p.Sku.Equals(t, StringComparison.OrdinalIgnoreCase));
        if (hit is not null) { Add(hit); _term = ""; }
    }

    private void Add(ProductDto p)
    {
        var line = _cart.FirstOrDefault(l => l.Product.Id == p.Id);
        if (line is null) _cart.Add(new Line { Product = p });
        else if (line.Quantity < p.QuantityOnHand) line.Quantity++;
    }

    private void Change(Line l, int delta)
    {
        var q = l.Quantity + delta;
        if (q <= 0) _cart.Remove(l);
        else if (q <= l.Product.QuantityOnHand) l.Quantity = q;
    }

    private async Task Checkout()
    {
        _busy = true; _error = null;
        try
        {
            var r = await Api.CheckoutAsync(new CheckoutRequest(
                _cart.Select(l => new SaleLineRequest(l.Product.Id, l.Quantity)).ToList(), _method, _tendered, _discount));
            Toast.Show($"Sale {r.ReceiptNumber} complete. Change {r.Change:N2}");
            _cart.Clear(); _discount = 0; _tendered = 0;
            await Load();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
