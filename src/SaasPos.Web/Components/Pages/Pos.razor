@page "/pos"
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="page-title mb-4">Point of Sale</MudText>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert> }

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudTextField @bind-Value="_term" Immediate="true" Placeholder="Search name or SKU — press Enter to scan a barcode"
                      Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="OnKey" Class="mb-4" />
        <MudGrid Spacing="3">
            @foreach (var p in Filtered)
            {
                <MudItem xs="6" sm="4" xl="3">
                    <div class="soft-card product-tile @(p.QuantityOnHand <= 0 ? "disabled" : "")" @onclick="() => Add(p)">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="product-avatar">@p.Name[..1].ToUpperInvariant()</div>
                            <MudChip T="string" Size="Size.Small" Color="@(p.QuantityOnHand <= 0 ? Color.Error : p.IsLowStock ? Color.Warning : Color.Success)" Variant="Variant.Text">
                                @(p.QuantityOnHand <= 0 ? "Out of stock" : $"{p.QuantityOnHand} in stock")
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body1" Style="font-weight:600;line-height:1.25">@p.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Sku</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">@p.Price.ToString("N2")</MudText>
                    </div>
                </MudItem>
            }
        </MudGrid>
        @if (!Filtered.Any())
        {
            <div class="soft-card pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" />
                <MudText Color="Color.Secondary" Class="mt-2">No products found.</MudText>
            </div>
        }
    </MudItem>

    <MudItem xs="12" lg="4">
        <div class="soft-card pa-4 cart-panel">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.h6">Current order</MudText>
                <MudSpacer />
                @if (_cart.Count > 0) { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => _cart.Clear()">Clear</MudButton> }
            </div>

            @if (_cart.Count == 0)
            {
                <div class="text-center py-8">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCartCheckout" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary" Class="mt-2">Tap a product to add it</MudText>
                </div>
            }
            @foreach (var l in _cart)
            {
                <div class="d-flex align-center py-2" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body2" Style="font-weight:600">@l.Product.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@l.Product.Price.ToString("N2") each</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => Change(l, -1)" />
                    <MudText Style="min-width:24px;text-align:center;font-weight:600">@l.Quantity</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => Change(l, 1)" />
                    <MudText Style="min-width:72px;text-align:right;font-weight:600">@((l.Product.Price * l.Quantity).ToString("N2"))</MudText>
                </div>
            }

            <MudNumericField T="decimal" @bind-Value="_discount" Min="0" Label="Discount" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" HideSpinButtons="true" />
            <div class="d-flex justify-space-between align-center my-3">
                <MudText Typo="Typo.body1" Color="Color.Secondary">Total</MudText>
                <span class="total-row">@Total.ToString("N2")</span>
            </div>

            <MudToggleGroup T="PaymentMethod" @bind-Value="_method" Color="Color.Primary" FixedContent="true" CheckMark="true" Class="mb-3" Style="width:100%">
                @foreach (var m in Enum.GetValues<PaymentMethod>()) { <MudToggleItem Value="m" Text="@m.ToString()" /> }
            </MudToggleGroup>
            <MudNumericField T="decimal" @bind-Value="_tendered" Min="0" Label="Amount tendered" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
            @if (_tendered > 0 && _tendered >= Total)
            {
                <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-1">Change due: <strong>@((_tendered - Total).ToString("N2"))</strong></MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Large" Class="mt-4"
                       StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@(_cart.Count == 0 || _busy)" OnClick="Checkout">
                Charge @Total.ToString("N2")
            </MudButton>
        </div>
    </MudItem>
</MudGrid>

@code {
    private class Line { public ProductDto Product { get; set; } = default!; public int Quantity { get; set; } = 1; }

    private List<ProductDto> _products = [];
    private readonly List<Line> _cart = [];
    private string _term = "";
    private decimal _discount, _tendered;
    private PaymentMethod _method = PaymentMethod.Cash;
    private string? _error;
    private bool _busy;

    private IEnumerable<ProductDto> Filtered => _products.Where(p =>
        string.IsNullOrWhiteSpace(_term) || p.Name.Contains(_term, StringComparison.OrdinalIgnoreCase)
        || p.Sku.Contains(_term, StringComparison.OrdinalIgnoreCase) || p.Barcode == _term.Trim());

    private decimal Total => Math.Max(0, _cart.Sum(l => l.Product.Price * l.Quantity) - _discount);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _products = await Api.ProductsAsync(null, true); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var t = _term.Trim();
        var hit = _products.FirstOrDefault(p => p.Barcode == t || p.Sku.Equals(t, StringComparison.OrdinalIgnoreCase));
        if (hit is not null) { Add(hit); _term = ""; }
    }

    private void Add(ProductDto p)
    {
        var line = _cart.FirstOrDefault(l => l.Product.Id == p.Id);
        if (line is null) _cart.Add(new Line { Product = p });
        else if (line.Quantity < p.QuantityOnHand) line.Quantity++;
    }

    private void Change(Line l, int delta)
    {
        var q = l.Quantity + delta;
        if (q <= 0) _cart.Remove(l);
        else if (q <= l.Product.QuantityOnHand) l.Quantity = q;
    }

    private async Task Checkout()
    {
        _busy = true; _error = null;
        try
        {
            var r = await Api.CheckoutAsync(new CheckoutRequest(
                _cart.Select(l => new SaleLineRequest(l.Product.Id, l.Quantity)).ToList(), _method, _tendered, _discount));
            Snackbar.Add($"Sale {r.ReceiptNumber} complete — change {r.Change:N2}", Severity.Success);
            _cart.Clear(); _discount = 0; _tendered = 0;
            await Load();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
