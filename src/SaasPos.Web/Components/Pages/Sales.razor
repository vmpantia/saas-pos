@page "/sales"
@inject ApiClient Api
@inject Session Session

<h3>Sales</h3>
@if (_error is not null) { <div class="alert alert-danger">@_error</div> }

<div class="row g-2 mb-3">
    <div class="col-auto"><input type="date" class="form-control" @bind="_from" /></div>
    <div class="col-auto"><input type="date" class="form-control" @bind="_to" /></div>
    <div class="col-auto"><button class="btn btn-primary" @onclick="Load">Search</button></div>
</div>

<table class="table table-sm align-middle">
    <thead><tr><th>Receipt</th><th>Date</th><th>Payment</th><th class="text-end">Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in _sales)
    {
        <tr class="@(s.Status == SaleStatus.Voided ? "text-muted text-decoration-line-through" : "")">
            <td>@s.ReceiptNumber</td><td>@s.CreatedAtUtc.ToLocalTime().ToString("g")</td><td>@s.PaymentMethod</td>
            <td class="text-end">@s.Total.ToString("N2")</td><td>@s.Status</td>
            <td class="text-end">
                @if (Session.IsManager && s.Status == SaleStatus.Completed)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Void(s)">Void</button>
                }
            </td>
        </tr>
        <tr><td colspan="6" class="small text-muted ps-4">@string.Join(", ", s.Items.Select(i => $"{i.Quantity} × {i.ProductName}"))</td></tr>
    }
    </tbody>
</table>

@code {
    private DateTime _from = DateTime.Today, _to = DateTime.Today;
    private List<SaleDto> _sales = [];
    private string? _error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _error = null;
        try { _sales = await Api.SalesAsync(_from.Date.ToUniversalTime(), _to.Date.AddDays(1).ToUniversalTime()); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private async Task Void(SaleDto s)
    {
        try { await Api.VoidAsync(s.Id); await Load(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }
}
