@page "/sales"
@inject ApiClient Api
@inject Session Session
@inject ToastService Toast

<div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Sales</h1>
    <p class="text-sm text-muted-foreground">Browse and manage completed transactions</p>
</div>
@if (_error is not null) { <div class="alert alert-destructive mb-4">@_error</div> }

<div class="card mb-4 flex flex-wrap items-end gap-4 p-4">
    <div><label class="label">From</label><input type="date" class="input" @bind="_from" /></div>
    <div><label class="label">To</label><input type="date" class="input" @bind="_to" /></div>
    <button class="btn btn-default" @onclick="Load"><Icon Name="search" />Search</button>
    <div class="flex-1"></div>
    <p class="text-sm text-muted-foreground">@_sales.Count sales · <strong class="text-foreground">@_sales.Where(s => s.Status == SaleStatus.Completed).Sum(s => s.Total).ToString("N2")</strong></p>
</div>

<div class="card overflow-x-auto">
    <table class="table">
        <thead><tr><th>Receipt</th><th>Date</th><th>Items</th><th>Payment</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in _sales)
            {
                <tr>
                    <td class="font-medium">@s.ReceiptNumber</td>
                    <td class="text-muted-foreground">@s.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td class="max-w-64 truncate text-xs text-muted-foreground">@string.Join(", ", s.Items.Select(i => $"{i.Quantity} x {i.ProductName}"))</td>
                    <td>@s.PaymentMethod</td>
                    <td class="font-semibold">@s.Total.ToString("N2")</td>
                    <td><span class="@($"badge {(s.Status == SaleStatus.Voided ? "badge-destructive" : "badge-success")}")">@s.Status</span></td>
                    <td class="text-right">
                        @if (Session.IsManager && s.Status == SaleStatus.Completed)
                        {
                            <button class="btn btn-ghost btn-sm text-destructive" @onclick="() => Void(s)">Void</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_sales.Count == 0) { <div class="p-10 text-center text-sm text-muted-foreground">No sales in this period.</div> }
</div>

@code {
    private DateTime _from = DateTime.Today, _to = DateTime.Today;
    private List<SaleDto> _sales = [];
    private string? _error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _error = null;
        try { _sales = await Api.SalesAsync(_from.Date.ToUniversalTime(), _to.Date.AddDays(1).ToUniversalTime()); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private async Task Void(SaleDto s)
    {
        try { await Api.VoidAsync(s.Id); Toast.Show($"Sale {s.ReceiptNumber} voided"); await Load(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }
}
