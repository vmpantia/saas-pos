@page "/products"
@inject ApiClient Api
@inject ISnackbar Snackbar

<div class="d-flex align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="page-title">Products</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_items.Count products in your catalog</MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="New">New product</MudButton>
</div>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert> }

<MudCollapse Expanded="_formOpen">
    <div class="soft-card pa-5 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">@(_editId is null ? "New product" : "Edit product")</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4" md="2"><MudTextField @bind-Value="_f.Sku" Label="SKU" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="8" md="4"><MudTextField @bind-Value="_f.Name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_f.Barcode" Label="Barcode" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid" @bind-Value="_f.CategoryId" Label="Category" Variant="Variant.Outlined">
                    <MudSelectItem T="Guid" Value="Guid.Empty">— none —</MudSelectItem>
                    @foreach (var c in _cats) { <MudSelectItem T="Guid" Value="c.Id">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_f.Price" Min="0" Label="Price" Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_f.Cost" Min="0" Label="Cost" Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_f.ReorderLevel" Min="0" Label="Reorder level" Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
            @if (_editId is null)
            {
                <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_f.InitialStock" Min="0" Label="Initial stock" Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
            }
        </MudGrid>
        <div class="d-flex align-center mt-4">
            <MudTextField @bind-Value="_newCat" Label="New category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px" />
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="AddCategory">Add category</MudButton>
            <MudSpacer />
            <MudButton Class="mr-2" OnClick="Close">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save product</MudButton>
        </div>
    </div>
</MudCollapse>

<MudTable Items="_items" Hover="true" Filter="Match" Elevation="0" Breakpoint="Breakpoint.Sm">
    <ToolBarContent>
        <MudTextField @bind-Value="_search" Placeholder="Search products…" Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Style="max-width:320px" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Product</MudTh><MudTh>Price</MudTh><MudTh>Cost</MudTh><MudTh>Stock</MudTh><MudTh>Status</MudTh><MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudText Typo="Typo.body2" Style="font-weight:600">@context.Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Sku</MudText>
        </MudTd>
        <MudTd>@context.Price.ToString("N2")</MudTd>
        <MudTd>@context.Cost.ToString("N2")</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.QuantityOnHand == 0 ? Color.Error : context.IsLowStock ? Color.Warning : Color.Success)">@context.QuantityOnHand</MudChip>
        </MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip></MudTd>
        <MudTd Style="text-align:right">
            <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context)" /></MudTooltip>
            <MudTooltip Text="@(context.IsActive ? "Deactivate" : "Activate")">
                <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)" Size="Size.Small"
                               Color="@(context.IsActive ? Color.Success : Color.Default)" OnClick="() => Toggle(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-6" Color="Color.Secondary">No products yet — click “New product”.</MudText></NoRecordsContent>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>

@code {
    private class Form
    {
        public string Sku { get; set; } = ""; public string Name { get; set; } = ""; public string? Barcode { get; set; }
        public Guid CategoryId { get; set; } public decimal Price { get; set; } public decimal Cost { get; set; }
        public int ReorderLevel { get; set; } public int InitialStock { get; set; }
    }

    private List<ProductDto> _items = [];
    private List<CategoryDto> _cats = [];
    private Form _f = new();
    private Guid? _editId;
    private bool _formOpen;
    private string _newCat = "", _search = "";
    private string? _error;

    private bool Match(ProductDto p) => string.IsNullOrWhiteSpace(_search)
        || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => Load();

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private Task Load() => Run(async () => { _items = await Api.ProductsAsync(); _cats = await Api.CategoriesAsync(); });

    private void New() { _editId = null; _f = new(); _formOpen = true; }
    private void Close() { _editId = null; _f = new(); _formOpen = false; }

    private Task Save() => Run(async () =>
    {
        var r = new ProductRequest(_f.Sku, _f.Name, _f.Price, _f.Cost, _f.ReorderLevel, _f.Barcode,
            _f.CategoryId == Guid.Empty ? null : _f.CategoryId, _f.InitialStock);
        if (_editId is null) await Api.CreateProductAsync(r); else await Api.UpdateProductAsync(_editId.Value, r);
        Snackbar.Add("Product saved", Severity.Success);
        Close();
        await Load();
    });

    private void Edit(ProductDto p)
    {
        _editId = p.Id; _formOpen = true;
        _f = new Form { Sku = p.Sku, Name = p.Name, Barcode = p.Barcode, CategoryId = p.CategoryId ?? Guid.Empty,
            Price = p.Price, Cost = p.Cost, ReorderLevel = p.ReorderLevel };
    }

    private Task Toggle(ProductDto p) => Run(async () => { await Api.SetActiveAsync(p.Id, !p.IsActive); await Load(); });

    private Task AddCategory() => Run(async () =>
    {
        if (string.IsNullOrWhiteSpace(_newCat)) return;
        await Api.CreateCategoryAsync(_newCat); _newCat = "";
        Snackbar.Add("Category added", Severity.Success);
        await Load();
    });
}
