@page "/products"
@inject ApiClient Api
@inject ToastService Toast

<div class="mb-6 flex items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Products</h1>
        <p class="text-sm text-muted-foreground">@_items.Count products in your catalog</p>
    </div>
    <button class="btn btn-default" @onclick="New"><Icon Name="plus" />New product</button>
</div>
@if (_error is not null) { <div class="alert alert-destructive mb-4">@_error</div> }

@if (_formOpen)
{
    <div class="card mb-6">
        <div class="card-header"><h2 class="card-title">@(_editId is null ? "New product" : "Edit product")</h2></div>
        <div class="card-body">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div><label class="label">SKU</label><input class="input" @bind="_f.Sku" /></div>
                <div class="lg:col-span-2"><label class="label">Name</label><input class="input" @bind="_f.Name" /></div>
                <div><label class="label">Barcode</label><input class="input" @bind="_f.Barcode" /></div>
                <div>
                    <label class="label">Category</label>
                    <select class="input" @bind="_f.CategoryId">
                        <option value="@Guid.Empty">None</option>
                        @foreach (var c in _cats) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div><label class="label">Price</label><input type="number" min="0" step="0.01" class="input" @bind="_f.Price" /></div>
                <div><label class="label">Cost</label><input type="number" min="0" step="0.01" class="input" @bind="_f.Cost" /></div>
                <div><label class="label">Reorder level</label><input type="number" min="0" class="input" @bind="_f.ReorderLevel" /></div>
                @if (_editId is null)
                {
                    <div><label class="label">Initial stock</label><input type="number" min="0" class="input" @bind="_f.InitialStock" /></div>
                }
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-2 border-t pt-4">
                <input class="input max-w-52" placeholder="New category" @bind="_newCat" />
                <button class="btn btn-outline" @onclick="AddCategory">Add category</button>
                <div class="flex-1"></div>
                <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                <button class="btn btn-default" @onclick="Save">Save product</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="p-4">
        <div class="relative max-w-sm">
            <span class="pointer-events-none absolute left-3 top-2.5 text-muted-foreground"><Icon Name="search" /></span>
            <input class="input pl-9" placeholder="Search products..." @bind="_search" @bind:event="oninput" />
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="table">
            <thead><tr><th>Product</th><th>Price</th><th>Cost</th><th>Stock</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Visible)
                {
                    <tr>
                        <td><div class="font-medium">@p.Name</div><div class="text-xs text-muted-foreground">@p.Sku</div></td>
                        <td>@p.Price.ToString("N2")</td>
                        <td class="text-muted-foreground">@p.Cost.ToString("N2")</td>
                        <td><span class="@($"badge {(p.QuantityOnHand == 0 ? "badge-destructive" : p.IsLowStock ? "badge-warning" : "badge-success")}")">@p.QuantityOnHand</span></td>
                        <td><span class="@($"badge {(p.IsActive ? "badge-outline" : "badge-secondary")}")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-right whitespace-nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => Edit(p)"><Icon Name="edit" />Edit</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => Toggle(p)">@(p.IsActive ? "Deactivate" : "Activate")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Visible.Any()) { <div class="p-10 text-center text-sm text-muted-foreground">No products found.</div> }
    </div>
</div>

@code {
    private class Form
    {
        public string Sku { get; set; } = ""; public string Name { get; set; } = ""; public string? Barcode { get; set; }
        public Guid CategoryId { get; set; } public decimal Price { get; set; } public decimal Cost { get; set; }
        public int ReorderLevel { get; set; } public int InitialStock { get; set; }
    }

    private List<ProductDto> _items = [];
    private List<CategoryDto> _cats = [];
    private Form _f = new();
    private Guid? _editId;
    private bool _formOpen;
    private string _newCat = "", _search = "";
    private string? _error;

    private IEnumerable<ProductDto> Visible => _items.Where(p => string.IsNullOrWhiteSpace(_search)
        || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => Load();

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }

    private Task Load() => Run(async () => { _items = await Api.ProductsAsync(); _cats = await Api.CategoriesAsync(); });

    private void New() { _editId = null; _f = new(); _formOpen = true; }
    private void Close() { _editId = null; _f = new(); _formOpen = false; }

    private Task Save() => Run(async () =>
    {
        var r = new ProductRequest(_f.Sku, _f.Name, _f.Price, _f.Cost, _f.ReorderLevel, _f.Barcode,
            _f.CategoryId == Guid.Empty ? null : _f.CategoryId, _f.InitialStock);
        if (_editId is null) await Api.CreateProductAsync(r); else await Api.UpdateProductAsync(_editId.Value, r);
        Toast.Show("Product saved");
        Close();
        await Load();
    });

    private void Edit(ProductDto p)
    {
        _editId = p.Id; _formOpen = true;
        _f = new Form { Sku = p.Sku, Name = p.Name, Barcode = p.Barcode, CategoryId = p.CategoryId ?? Guid.Empty,
            Price = p.Price, Cost = p.Cost, ReorderLevel = p.ReorderLevel };
    }

    private Task Toggle(ProductDto p) => Run(async () => { await Api.SetActiveAsync(p.Id, !p.IsActive); await Load(); });

    private Task AddCategory() => Run(async () =>
    {
        if (string.IsNullOrWhiteSpace(_newCat)) return;
        await Api.CreateCategoryAsync(_newCat); _newCat = "";
        Toast.Show("Category added");
        await Load();
    });
}
