@page "/"
@inject ApiClient Api
@inject Session Session
@inject NavigationManager Nav

<div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
    <p class="text-sm text-muted-foreground">Performance over the last 30 days</p>
</div>
@if (_error is not null) { <div class="alert alert-destructive mb-4">@_error</div> }

@if (_s is null && _error is null)
{
    <div class="h-1 w-full animate-pulse rounded bg-muted"></div>
}
else if (_s is not null)
{
    <div class="grid gap-4 md:grid-cols-3">
        <div class="card p-6">
            <div class="flex items-center justify-between text-sm font-medium text-muted-foreground">Sales <Icon Name="receipt" /></div>
            <div class="mt-2 text-3xl font-bold tracking-tight">@_s.SaleCount</div>
        </div>
        <div class="card p-6">
            <div class="flex items-center justify-between text-sm font-medium text-muted-foreground">Revenue <Icon Name="wallet" /></div>
            <div class="mt-2 text-3xl font-bold tracking-tight">@_s.Revenue.ToString("N2")</div>
        </div>
        <div class="card p-6">
            <div class="flex items-center justify-between text-sm font-medium text-muted-foreground">Gross profit <Icon Name="trending" /></div>
            <div class="mt-2 text-3xl font-bold tracking-tight">@_s.Profit.ToString("N2")</div>
        </div>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-7">
        <div class="card lg:col-span-4">
            <div class="card-header"><h2 class="card-title">Top products</h2><p class="card-desc">Best sellers by revenue</p></div>
            <div class="card-body flex flex-col gap-5">
                @if (_s.TopProducts.Count == 0) { <p class="text-sm text-muted-foreground">No sales in this period yet.</p> }
                @foreach (var t in _s.TopProducts)
                {
                    <div>
                        <div class="mb-2 flex justify-between text-sm">
                            <span class="font-medium">@t.ProductName</span>
                            <span class="text-muted-foreground">@t.QuantitySold sold · @t.Revenue.ToString("N2")</span>
                        </div>
                        <div class="progress"><div style="width:@Pct(t)%"></div></div>
                    </div>
                }
            </div>
        </div>
        <div class="card lg:col-span-3">
            <div class="card-header">
                <div class="flex items-center justify-between">
                    <h2 class="card-title">Low stock</h2>
                    @if (_low.Count > 0) { <span class="badge badge-destructive">@_low.Count</span> }
                </div>
                <p class="card-desc">Items at or below reorder level</p>
            </div>
            <div class="card-body flex flex-col">
                @if (_low.Count == 0) { <p class="text-sm text-muted-foreground">All products are well stocked.</p> }
                @foreach (var p in _low)
                {
                    <div class="flex items-center justify-between border-b py-3 last:border-0">
                        <div>
                            <div class="text-sm font-medium">@p.Name</div>
                            <div class="text-xs text-muted-foreground">Reorder at @p.ReorderLevel</div>
                        </div>
                        <span class="@($"badge {(p.QuantityOnHand == 0 ? "badge-destructive" : "badge-warning")}")">@p.QuantityOnHand left</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private SalesSummaryDto? _s;
    private List<ProductDto> _low = [];
    private string? _error;

    private double Share(TopProductDto t)
    {
        var max = _s!.TopProducts.Max(x => x.Revenue);
        return max == 0 ? 0 : (double)(t.Revenue / max * 100);
    }

    private string Pct(TopProductDto t) => Share(t).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsManager) { Nav.NavigateTo("pos"); return; }
        try
        {
            _s = await Api.SummaryAsync(DateTime.UtcNow.Date.AddDays(-30), DateTime.UtcNow.AddDays(1));
            _low = (await Api.ProductsAsync(null, true)).Where(p => p.IsLowStock).ToList();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; }
    }
}
