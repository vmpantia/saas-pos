@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject NavigationManager Nav

<div class="@(_dark ? "dark" : "") min-h-screen bg-background text-foreground">
    @if (!_ready)
    {
        <div class="h-0.5 w-full animate-pulse bg-primary"></div>
    }
    else if (!Session.IsSignedIn)
    {
        <div class="flex min-h-screen items-center justify-center bg-muted/40 p-4">@Body</div>
    }
    else
    {
        @if (_menu)
        {
            <div class="fixed inset-0 z-30 bg-black/50 md:hidden" @onclick="() => _menu = false"></div>
        }
        <aside class="@($"fixed inset-y-0 left-0 z-40 flex w-64 flex-col border-r bg-card transition-transform md:translate-x-0 {(_menu ? "translate-x-0" : "-translate-x-full")}")">
            <div class="flex h-14 items-center gap-2 border-b px-5">
                <div class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground"><Icon Name="cart" /></div>
                <span class="font-semibold tracking-tight">SaaS POS</span>
            </div>
            <div class="flex-1 overflow-y-auto p-3" @onclick="() => _menu = false"><NavMenu /></div>
            <div class="border-t p-3">
                <div class="flex items-center gap-3 rounded-md p-2">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-semibold">@Initials</div>
                    <div class="min-w-0 flex-1 leading-tight">
                        <div class="truncate text-sm font-medium">@Session.Current!.FullName</div>
                        <div class="truncate text-xs text-muted-foreground">@Session.Current.Role</div>
                    </div>
                    <button class="btn btn-ghost btn-icon btn-sm" title="Sign out" @onclick="SignOut"><Icon Name="logout" /></button>
                </div>
            </div>
        </aside>

        <div class="md:pl-64">
            <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b bg-background/80 px-4 backdrop-blur md:px-8">
                <button class="btn btn-ghost btn-icon btn-sm md:hidden" @onclick="() => _menu = true"><Icon Name="menu" /></button>
                <span class="text-sm font-medium text-muted-foreground">@Session.Current.TenantName</span>
                <div class="flex-1"></div>
                <button class="btn btn-outline btn-icon btn-sm" title="Toggle theme" @onclick="() => _dark = !_dark"><Icon Name="@(_dark ? "sun" : "moon")" /></button>
            </header>
            <main class="mx-auto max-w-7xl p-4 md:p-8">@Body</main>
        </div>
    }
    <ToastHost />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _ready, _dark, _menu;

    private string Initials => string.Concat((Session.Current?.FullName ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    protected override void OnInitialized() => Session.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.RestoreAsync();
        _ready = true;
        Redirect();
        StateHasChanged();
    }

    private void OnChanged()
    {
        if (_ready) Redirect();
        InvokeAsync(StateHasChanged);
    }

    private void Redirect()
    {
        var onLogin = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);
        if (!Session.IsSignedIn && !onLogin) Nav.NavigateTo("login");
        else if (Session.IsSignedIn && onLogin) Nav.NavigateTo("");
    }

    private Task SignOut() => Session.SignOutAsync();

    public void Dispose() => Session.Changed -= OnChanged;
}
