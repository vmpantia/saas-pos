@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_ready)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!Session.IsSignedIn)
{
    <div class="auth-bg">@Body</div>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0" Color="Color.Surface">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" />
            <MudText Typo="Typo.subtitle1" Class="ml-2" Style="font-weight:600">@Session.Current!.TenantName</MudText>
            <MudSpacer />
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" OnClick="() => _dark = !_dark" />
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-2" Style="cursor:pointer">
                        <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initials</MudAvatar>
                        <div class="d-none d-sm-block" style="line-height:1.2">
                            <MudText Typo="Typo.body2" Style="font-weight:600">@Session.Current.FullName</MudText>
                            <MudText Typo="Typo.caption">@Session.Current.Role</MudText>
                        </div>
                    </MudStack>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOut">Sign out</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawer" Elevation="0" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
            <div class="brand">
                <div class="brand-logo"><MudIcon Icon="@Icons.Material.Filled.PointOfSale" Style="color:#fff" /></div>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="color:#fff;font-weight:700;line-height:1.1">SaaS POS</MudText>
                    <MudText Typo="Typo.caption" Style="color:#94A3B8">Retail suite</MudText>
                </div>
            </div>
            <NavMenu />
        </MudDrawer>
        <MudMainContent Style="background:var(--mud-palette-background)">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">@Body</MudContainer>
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _ready, _dark;
    private bool _drawer = true;

    private string Initials => string.Concat((Session.Current?.FullName ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5", Secondary = "#0EA5E9", Tertiary = "#8B5CF6",
            Success = "#10B981", Warning = "#F59E0B", Error = "#EF4444", Info = "#3B82F6",
            Background = "#F4F6FB", Surface = "#FFFFFF", BackgroundGray = "#F8FAFC",
            AppbarBackground = "#FFFFFF", AppbarText = "#0F172A",
            DrawerBackground = "#0F172A", DrawerText = "#CBD5E1", DrawerIcon = "#94A3B8",
            TextPrimary = "#0F172A", TextSecondary = "#64748B",
            LinesDefault = "#E2E8F0", TableLines = "#EEF2F7", Divider = "#E2E8F0",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8", Secondary = "#38BDF8", Tertiary = "#A78BFA",
            Success = "#34D399", Warning = "#FBBF24", Error = "#F87171", Info = "#60A5FA",
            Background = "#0B1120", Surface = "#111827", BackgroundGray = "#0F172A",
            AppbarBackground = "#111827", AppbarText = "#E5E7EB",
            DrawerBackground = "#0F172A", DrawerText = "#CBD5E1", DrawerIcon = "#94A3B8",
            LinesDefault = "#1F2937", TableLines = "#1F2937", Divider = "#1F2937",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px", DrawerWidthLeft = "260px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "Roboto", "Helvetica", "Arial", "sans-serif"] },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "600" },
        }
    };

    protected override void OnInitialized() => Session.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.RestoreAsync();
        _ready = true;
        Redirect();
        StateHasChanged();
    }

    private void OnChanged()
    {
        if (_ready) Redirect();
        InvokeAsync(StateHasChanged);
    }

    private void Redirect()
    {
        var onLogin = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);
        if (!Session.IsSignedIn && !onLogin) Nav.NavigateTo("login");
        else if (Session.IsSignedIn && onLogin) Nav.NavigateTo("");
    }

    private Task SignOut() => Session.SignOutAsync();

    public void Dispose() => Session.Changed -= OnChanged;
}
